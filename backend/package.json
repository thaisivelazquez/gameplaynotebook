{
  "name": "nfl-pickem-backend",
  "version": "1.0.0",
  "description": "Backend API for NFL Pick'em fantasy predictions",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f src/db/seed.sql",
    "db:migrate-lineup": "psql \"$DATABASE_URL\" -f src/db/migration_lineup.sql",
    "db:migrate-stats": "psql \"$DATABASE_URL\" -f src/db/migration_stats_history.sql",
    "db:migrate-player-stats": "psql \"$DATABASE_URL\" -f src/db/migration_player_stats.sql",
    "db:migrate-category-history": "psql \"$DATABASE_URL\" -f src/db/migration_category_history.sql",
    "db:migrate-injuries": "psql \"$DATABASE_URL\" -f src/db/migration_injuries.sql",
    "db:seed-player-stats": "psql \"$DATABASE_URL\" -f src/db/seed_player_stats.sql",
    "db:seed-players": "psql \"$DATABASE_URL\" -f src/db/seed_players.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}